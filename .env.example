# ---- Required ----
# Postgres connection string (Neon, Supabase, Render…). Local testing: pglite:./.data
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# OpenRouter key: https://openrouter.ai/keys (free models: allow free endpoints in
# https://openrouter.ai/settings/privacy, or requests fail with "No endpoints found")
OPENROUTER_API_KEY=
# Comma-separated emails that can open the Admin page
ADMIN_EMAILS=you@example.com

# ---- Recommended ----
APP_URL=https://your-domain.tn
SUPPORT_EMAIL=help@your-domain.tn
BUSINESS_NAME=Your company SUARL, address
MATRICULE_FISCAL=0000000/X/A/M/000
INPDP_DECLARATION=
# Shown to users who pay by D17 or bank transfer (line breaks allowed)
MANUAL_PAY_INFO=D17: 00 000 000 (name)\nRIB: 00 000 0000000000000 00
# Prices in TND incl. VAT (JSON)
PRICES_TND={"solo":{"month":15,"year":150},"duo":{"month":25,"year":250}}

# ---- Payments (optional; each method appears only when its keys are set) ----
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# Sandbox: https://api.sandbox.konnect.network/api/v2
KONNECT_API_BASE=https://api.konnect.network/api/v2
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=

# ---- Password reset by email (optional) ----
RESEND_API_KEY=
MAIL_FROM=Prep Canada <no-reply@your-domain.tn>

# ---- Caching and limits (optional) ----
PAID_SECTIONS_PER_MONTH=60
AUDIO_CACHE_MAX_MB=400
POOL_FRESH_SMALL=0
POOL_FRESH_MID=0
POOL_FRESH_BIG=0
POOL_SMALL=15
POOL_MID=60
POOL_RETIRE_REPORTS=3
USD_TND=3.1
# Models ending in :free are logged at $0. Prices for paid models, USD per 1M tokens:
# AI_PRICES_JSON={"gemini-3.8-flash-tts":{"in":0.5,"audio":9}}

# ---- Models (optional overrides) ----
# Comma-separated OpenRouter models, tried in order when one is rate-limited or down.
# Main: marking, test and course generation. Fast: lesson feedback, TEF examiner, writing/speaking papers.
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,openrouter/free
AI_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free,openrouter/free
# Model reasoning: better marking, but free models then get too slow for the 2-minute request limit
# AI_REASONING=1

# ---- Studio voices (optional, paid) ----
# Gemini text-to-speech for Listening and speaking. Leave empty to use the device voices only.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# ---- Testing only ----
# Offline AI and voices (no API calls)
# AI_MOCK=1
# Don't fetch Express Entry rounds from IRCC (use bundled / admin data only)
# DRAWS_OFFLINE=1
# PAYMENTS_MOCK=1
