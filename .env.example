# ---- Required ----
# Postgres connection string (Neon, Supabase, Render…). Local testing: pglite:./.data
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated emails that can open the Admin page
ADMIN_EMAILS=you@example.com

# ---- Recommended ----
APP_URL=https://your-domain.tn
SUPPORT_EMAIL=help@your-domain.tn
BUSINESS_NAME=Your company SUARL, address
MATRICULE_FISCAL=0000000/X/A/M/000
INPDP_DECLARATION=
# Shown to users who pay by D17 or bank transfer (line breaks allowed)
MANUAL_PAY_INFO=D17: 00 000 000 (name)\nRIB: 00 000 0000000000000 00
# Prices in TND incl. VAT (JSON)
PRICES_TND={"solo":{"month":15,"year":150},"duo":{"month":25,"year":250}}

# ---- Payments (optional; each method appears only when its keys are set) ----
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# Sandbox: https://api.sandbox.konnect.network/api/v2
KONNECT_API_BASE=https://api.konnect.network/api/v2
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=

# ---- Password reset by email (optional) ----
RESEND_API_KEY=
MAIL_FROM=Prep Canada <no-reply@your-domain.tn>

# ---- Models (optional overrides) ----
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# ---- Testing only ----
# GEMINI_MOCK=1
# PAYMENTS_MOCK=1
